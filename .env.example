# O FOCUS funciona sem .env: nesse caso usa banco local no navegador.
# Este arquivo só é necessário quando você quiser forçar um backend específico.

# Opções: local | supabase | auto
# auto = usa Supabase se as chaves existirem; caso contrário usa banco local.
VITE_DATA_BACKEND="local"

# Futuro: ao publicar com Supabase, troque para "supabase" e preencha abaixo.
SUPABASE_PROJECT_ID="seu-project-id"
SUPABASE_URL="https://seu-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua-chave-publicavel"

VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-publicavel"

# Nunca envie o arquivo .env real para o GitHub.
